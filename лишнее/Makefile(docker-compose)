# ============================================
# PERSONAL ASSISTANT - DOCKER MANAGEMENT
# ============================================

.PHONY: help up down logs clean restart psql redis dbeaver pgadmin

help:
	@echo "Personal Assistant Docker Management"
	@echo ""
	@echo "Commands:"
	@echo "  make up          Start all services"
	@echo "  make up-dev      Start with monitoring tools"
	@echo "  make down        Stop all services"
	@echo "  make logs        Show logs"
	@echo "  make clean       Remove all containers and volumes"
	@echo "  make restart     Restart services"
	@echo "  make psql        Connect to PostgreSQL"
	@echo "  make redis       Connect to Redis"
	@echo "  make dbeaver     Show DBeaver connection info"
	@echo "  make pgadmin     Open pgAdmin in browser"
	@echo ""

up:
	@echo "🚀 Starting Personal Assistant..."
	@docker-compose up -d postgres redis ollama
	@echo "⏳ Waiting for initialization..."
	@docker-compose up init
	@echo ""
	@echo "✅ Services started successfully!"
	@echo "📊 Access:"
	@echo "  PostgreSQL: localhost:5432"
	@echo "  Redis:      localhost:6379"
	@echo "  Ollama:     localhost:11435"

up-dev: up
	@echo "🔧 Starting monitoring tools..."
	@docker-compose --profile monitoring up -d
	@echo "📊 Monitoring:"
	@echo "  pgAdmin:    http://localhost:5050"
	@echo "  RedisInsight: http://localhost:8001"

down:
	@echo "🛑 Stopping services..."
	@docker-compose down

logs:
	@docker-compose logs -f

clean:
	@echo "🧹 Cleaning up..."
	@docker-compose down -v
	@rm -rf data
	@echo "✅ Cleanup complete!"

restart: down up

psql:
	@source .env 2>/dev/null || true
	@docker exec -it $$(docker-compose ps -q postgres) \
		psql -U $${POSTGRES_USER:-personal_assistant_app} \
		-d $${POSTGRES_DB:-personal_assistant}

redis:
	@source .env 2>/dev/null || true
	@docker exec -it $$(docker-compose ps -q redis) \
		redis-cli -a $${REDIS_PASSWORD:-RedisAutoPass123!}

dbeaver:
	@echo "🔗 DBeaver Connection Info:"
	@echo "=========================="
	@echo "Host:     localhost"
	@echo "Port:     5432"
	@echo "Database: personal_assistant"
	@echo "User:     dbeaver_user"
	@echo "Password: dbeaver_dev_123"
	@echo ""
	@echo "📋 JDBC URL:"
	@echo "jdbc:postgresql://localhost:5432/personal_assistant"
	@echo ""
	@echo "💡 Use this for read-only access in DBeaver"

pgadmin:
	@echo "🌐 Opening pgAdmin..."
	@open http://localhost:5050 2>/dev/null || \
	xdg-open http://localhost:5050 2>/dev/null || \
	echo "Open manually: http://localhost:5050"
